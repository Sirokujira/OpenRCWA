OpenRCWA 4 2
title = RCWA sample: Drude metal film on glass (.ofd, dispersive)
#
# .ofd 経路 (GUI) の分散材料。rcwadispersion で層の材料に Lorentz 極を与える:
#   rcwadispersion = <layer(1..)> <side(1|2)> <einf> <ae> <be> <ce>   [rad/s]
#   eps(w) = einf + sum ae^2 / (ce^2 - w^2 - i*be*w)
# layer は rcwalayer を書いた順の番号 (1 始まり)、side は 1 = eps1, 2 = eps2。
# 分散を指定した材料では rcwalayer の静的な誘電率は使われない。
# 同じ (layer, side) に複数行書くと極が加算され、einf は最後の行の値になる。
# be > 0 が損失 (exp(-iwt))。Drude 金属は ce = 0, ae = プラズマ周波数, be = 衝突周波数。
#
#   空気 / Drude 金属 30 nm (wp = 1.36e16, gamma = 3e13 rad/s) / ガラス
#   data/sample/rcwa_metal_drude.orcwa と同じ構造。損失があるので R+T < 1, A > 0。
#   R, T は薄膜の特性行列法 (Airy の式) と 1e-9 で一致する (ci/check_rcwa_ofd_dispersion.py)。
rcwa = 2 5.0e-7
rcwalayer = 1.0 1.0 0.5 0
rcwalayer = 1.0 1.0 0.5 3.0e-8
rcwalayer = 2.25 2.25 0.5 0
# 一様層なので eps1 / eps2 の両方に同じ極を与える
rcwadispersion = 2 1 1.0 1.36e16 3.0e13 0.0
rcwadispersion = 2 2 1.0 1.36e16 3.0e13 0.0
planewave = 0 0 1
frequency1 = 4.0e14 7.0e14 6
end
