OpenRCWA 4 2
title = RCWA sample: subwavelength grating on glass substrate
# rcwa = <harmonics N> <period[m]>
# N=12 (25 次数)。TM は誘電率境界で法線 E が不連続になるぶん収束が遅く、
# N=5 では R_TM が収束値から約 1% ずれる (N=5: 0.2048 / N=20: 0.2068 @461nm)。
# TE は N=5 でも 1e-4 精度だが、TM に合わせて N=12 にしてある。
rcwa = 12 3.0e-7
# rcwalayer = <eps1> <eps2> <fill> <thickness[m]>  (入射側 → 透過側)
# 先頭と末尾は半無限層 (thickness は無視される)
rcwalayer = 1.0 1.0 0.5 0
rcwalayer = 4.0 1.0 0.5 2.0e-7
rcwalayer = 2.25 2.25 0.5 0
# 可視域掃引: lambda = 0.4 - 0.7 um (f = c/lambda)
frequency1 = 4.3e14 7.5e14 16
end
