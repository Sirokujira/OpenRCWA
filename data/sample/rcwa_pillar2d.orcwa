OpenRCWA 4 2
title = RCWA sample 3: 2D square lattice of glass pillars (metasurface)
#
# 2D 周期構造 (x/y 両方向に周期) の例。ガラス円柱を正方格子に並べた
# メタサーフェスを法線入射で解く。
#
#   周期 = 0.5 um (x, y とも) / 円柱半径 = 0.15 um / 高さ = 0.2 um
#   入射側 = 空気、透過側 = ガラス基板
#
# 実行:
#   ./bin/orcwa_rcwa -o rcwa.csv data/sample/rcwa_pillar2d.orcwa
#
# 2D なので rcwaorder の ny を 0 でなく有限値にする (nx=ny=4 → 9x9=81 次数)。
# ハーモニクス数は計算量に効く (行列サイズ ∝ nx*ny) ので、収束を見ながら
# 上げること。無損失なので R+T=1 が成立するはずで、これが妥当性の目安になる。
#
# 注意 (Wood アノマリー): 波長が周期 0.5 um に近づくと回折次数が
# すれすれ (kz≈0) になり数値的に不安定になる。掃引範囲は 0.6-0.9 um に
# とってあり、回折次数が確実に evanescent 側に入るようにしている。
xmesh = -2.5e-07 40 2.5e-07
ymesh = -2.5e-07 40 2.5e-07
# z 領域は 3 つ: [-0.6,-0.2]=ガラス基板 / [-0.2,0]=円柱層 / [0,0.6]=空気
zmesh = -6e-07 10 -2e-07 10 0.0 10 6e-07
material = 1 2.25 0 1 0
# ガラス基板 (透過側の半無限層 — 均質でなければならない)
geometry = 2 1 -2.5e-07 2.5e-07 -2.5e-07 2.5e-07 -6e-07 -2e-07
# ガラス円柱 (shape=11: z 軸方向の円柱。x/y の範囲が楕円の外接矩形)
geometry = 2 11 -1.5e-07 1.5e-07 -1.5e-07 1.5e-07 -2e-07 0
planewave = 0 0 1
pbc = 1 1 0
rcwaorder = 4 4
frequency1 = 3.33e14 5.0e14 8
end
